{
  "description": "Centralized access control rules for AI agents. All agents and the pre-commit hook read this file.",
  "rules": {
    "se": {
      "label": "Software Engineer",
      "allow_paths": [
        "backend/**",
        "frontend/**",
        "ai/tasks/**",
        "ai/changes/**",
        "ai/schema/**",
        "ai/PROJECT_BOARD.md",
        "ai/docs/changelog.md",
        "ai/failures/**"
      ],
      "allow_branches": [
        "feature/*",
        "bugfix/*",
        "enhancement/*",
        "prd/*"
      ]
    },
    "qa": {
      "label": "QA Engineer",
      "allow_paths": [
        "ai/tasks/**",
        "ai/tests/**",
        "ai/scripts/**",
        "ai/schema/**",
        "ai/PROJECT_BOARD.md",
        "ai/docs/changelog.md",
        "ai/failures/**"
      ],
      "allow_branches": [
        "prd/*"
      ]
    },
    "pm": {
      "label": "Product Manager",
      "allow_paths": [
        "ai/prd/**",
        "ai/tasks/**",
        "ai/docs/*.md",
        "ai/PROJECT_BOARD.md",
        "ai/docs/changelog.md",
        "ai/schema/**",
        "ai/failures/**"
      ],
      "allow_branches": [
        "main"
      ]
    },
    "tw": {
      "label": "Technical Writer",
      "allow_paths": [
        "ai/modules/**",
        "ai/flows/**",
        "ai/schema/**",
        "ai/failures/**"
      ],
      "allow_branches": [
        "*"
      ]
    }
  },
  "shared_paths": {
    "ai/PROJECT_BOARD.md": {
      "agents": ["se", "qa", "pm"]
    },
    "ai/docs/changelog.md": {
      "agents": ["se", "qa", "pm"]
    }
  }
}
